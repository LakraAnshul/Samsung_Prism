  step_number: 2
  instruction_preview: Do not repeatedly reset the breaker or replace the fuse while the washer remains connected if the protective device continues to trip.
  chunk_ids: ['WA5471ABP_01_Starting_Power_Problems_Detailed_parent_007_child_007']
  page_numbers: [7, 8]
  source_document: WA5471ABP_01_Starting_Power_Problems_Detailed

